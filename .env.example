NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
NUXT_PUBLIC_API_BASE=http://localhost:4000/api/v1
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agile?schema=public
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30
COOKIE_SECURE=false
DEMO_USER_EMAIL=demo@example.com
DEMO_USER_PASSWORD=ChangeMe123!
# Optional: set to the shared parent domain (e.g. .example.com) when web and API use different subdomains
COOKIE_DOMAIN=
COOKIE_SAME_SITE=lax
